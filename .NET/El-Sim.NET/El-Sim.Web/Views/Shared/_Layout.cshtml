@inject ElSimDbContext DbContext
@{
  var headerPassTier = string.Empty;

  if (User.Identity?.IsAuthenticated == true && int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out var headerUserId))
  {
    var headerPassName = await DbContext.ProductPurchases
      .AsNoTracking()
      .Where(item => item.UserId == headerUserId && item.Category == "pass" && item.ProductType == "pass" && item.Status == "Active")
      .OrderByDescending(item => item.CreatedAtUtc)
      .Select(item => item.ProductName)
      .FirstOrDefaultAsync();

    headerPassTier = headerPassName?.Contains("Ultra", StringComparison.OrdinalIgnoreCase) == true
      ? "Ultra"
      : headerPassName?.Contains("Plus", StringComparison.OrdinalIgnoreCase) == true
        ? "Plus"
        : string.Empty;
  }
}
<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>@ViewData["Title"]</title>
  <link rel="icon" type="image/png" href="/Assets/Image/Logo/El-Sim_Favicon_Large.png">
  <link rel="apple-touch-icon" href="/Assets/Image/Logo/El-Sim_Favicon_Large.png">
  <link
    href="https://fonts.googleapis.com/css2?family=Syne:wght@@600;700;800&family=DM+Sans:wght@@400;500;700&display=swap"
    rel="stylesheet">
  <link rel="stylesheet" href="/Assets/Style/main-style.css">
  <link rel="stylesheet" href="/Assets/Style/main-responsive.css">
  <script defer src="/Assets/Script/main-script.js"></script>
  <script defer src="/Assets/Script/lang.js"></script>
  <script defer src="/Assets/Script/support-chat.js"></script>
  <script defer src="/Assets/Script/carousel.js"></script>
</head>

<body class="@(ViewData["SupportChrome"] as bool? == true ? "support-chat-page" : "")">
  @if (ViewData["SupportChrome"] as bool? == true)
  {
    <header class="site-header support-page-header">
      <a class="brand" href="/" aria-label="El-Sim home">
        <img src="/Assets/Image/Logo/El-Sim_Logo_Icon.png" alt="El-Sim">
        <span>El-Sim</span>
      </a>

      <a class="support-home-link" href="/" aria-label="Home">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M3 11 12 3l9 8"></path>
          <path d="M5 10v10h14V10"></path>
          <path d="M9 20v-6h6v6"></path>
        </svg>
        <span>Home</span>
      </a>

      <div class="language-switch" aria-label="Language">
        <button type="button" data-lang-button="en">EN</button>
        <button type="button" data-lang-button="ru">RU</button>
        <button type="button" data-lang-button="az">AZ</button>
      </div>
    </header>
  }
  else
  {
  <header class="site-header">
    <a class="brand" href="/" aria-label="El-Sim">
      <img src="/Assets/Image/Logo/El-Sim_Logo_Icon.png" alt="El-Sim">
      <span>El-Sim</span>
    </a>

    <button class="menu-toggle" type="button" aria-label="Open menu" aria-expanded="false"
      aria-controls="main-navigation">
      <span></span>
      <span></span>
      <span></span>
    </button>

    <nav class="nav-links" id="main-navigation" aria-label="Main navigation">
      <a href="/pass" aria-label="Pass">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M7 4h10a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z"></path>
          <path d="M8 8h8"></path>
          <path d="M8 12h5"></path>
          <path d="M9 16h6"></path>
        </svg>
        <span>Pass</span>
      </a>
      <a href="/plans" aria-label="Plans">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M5 19V7a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v12"></path>
          <path d="M4 19h16"></path>
          <path d="M8 9h8"></path>
          <path d="M8 13h3"></path>
          <path d="M14 13h2"></path>
        </svg>
        <span>Plans</span>
      </a>
      <a href="/global" aria-label="Global">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="9"></circle>
          <path d="M3 12h18"></path>
          <path d="M12 3a14 14 0 0 1 0 18"></path>
          <path d="M12 3a14 14 0 0 0 0 18"></path>
        </svg>
        <span>Global</span>
      </a>
      <a href="/activation" aria-label="Activation">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 3v6"></path>
          <path d="m9 6 3-3 3 3"></path>
          <path d="M7 10a5 5 0 1 0 10 0"></path>
          <path d="M6 20h12"></path>
        </svg>
        <span>Activation</span>
      </a>
      <a href="/wifi" aria-label="WI-FI">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M5 12.5a10 10 0 0 1 14 0"></path>
          <path d="M8.5 16a5 5 0 0 1 7 0"></path>
          <path d="M12 20h.01"></path>
          <path d="M2 9a15 15 0 0 1 20 0"></path>
        </svg>
        <span>WI-FI</span>
      </a>
      <a href="/support" aria-label="Support">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 12a8 8 0 0 1 16 0v4a2 2 0 0 1-2 2h-2"></path>
          <path d="M6 13v3a2 2 0 0 0 2 2"></path>
          <path d="M18 13v3"></path>
          <path d="M9 19h6"></path>
        </svg>
        <span>Support</span>
      </a>
    </nav>

    @if (User.Identity?.IsAuthenticated == true)
    {
      <a class="header-action" href="/profile">@User.Identity.Name@if (!string.IsNullOrWhiteSpace(headerPassTier)) { <span class="header-pass-divider">|</span> <span>@headerPassTier</span> }</a>
    }
    else
    {
      <a class="header-action" href="/login">Login</a>
    }
  </header>
  }

  @RenderBody()

  @if (ViewData["SupportChrome"] as bool? != true)
  {
  <footer class="site-footer">
    <span>El-Sim</span>
    <div class="language-switch" aria-label="Language">
      <button type="button" data-lang-button="en">EN</button>
      <button type="button" data-lang-button="ru">RU</button>
      <button type="button" data-lang-button="az">AZ</button>
    </div>
    <span>Elsim &copy; 2026</span>
    <span>Baku, Azerbaijan</span>
  </footer>
  }
</body>

</html>
