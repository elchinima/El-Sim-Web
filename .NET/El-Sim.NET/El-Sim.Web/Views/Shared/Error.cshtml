@model ErrorViewModel

@{
    ViewData["Title"] = $"{Model.StatusCode} - {Model.Title}";
}

<main class="error-shell">
    <section class="error-hero" aria-labelledby="error-title">
        <div class="error-copy">
            <p class="eyebrow">El-Sim signal center</p>
            <h1 id="error-title">@Model.Title</h1>
            <p class="error-message">@Model.Message</p>

            <div class="error-code" aria-label="Error code">
                <span>Status code</span>
                <strong>@Model.StatusCode</strong>
            </div>

            @if (Model.ShowRequestId)
            {
                <p class="error-request">
                    Request ID
                    <code>@Model.RequestId</code>
                </p>
            }

            <div class="error-actions">
                <a class="button button-primary" href="/">Go home</a>
                <a class="button button-secondary" href="/#support">Contact support</a>
            </div>
        </div>

        <div class="error-stage" aria-hidden="true">
            <div class="signal-grid"></div>
            <div class="signal-orbit orbit-one"></div>
            <div class="signal-orbit orbit-two"></div>
            <div class="signal-orbit orbit-three"></div>
            <div class="esim-card">
                <span class="chip-line chip-line-one"></span>
                <span class="chip-line chip-line-two"></span>
                <span class="chip-line chip-line-three"></span>
                <img src="/Assets/Image/Logo/El-Sim_Logo_Icon.png" alt="">
            </div>
            <div class="signal-wave wave-one"></div>
            <div class="signal-wave wave-two"></div>
            <div class="signal-wave wave-three"></div>
            <span class="spark spark-one"></span>
            <span class="spark spark-two"></span>
            <span class="spark spark-three"></span>
            <span class="spark spark-four"></span>
        </div>
    </section>
</main>

<style>
    .error-shell {
        width: min(1120px, calc(100% - 40px));
        min-height: calc(100vh - 210px);
        display: grid;
        place-items: center;
        margin: 0 auto;
        padding: 74px 0 86px;
    }

    .error-hero {
        width: 100%;
        display: grid;
        grid-template-columns: minmax(0, 0.95fr) minmax(340px, 1fr);
        align-items: center;
        gap: 54px;
        padding: 46px;
        border: 1px solid rgba(255, 255, 255, 0.16);
        border-radius: 28px;
        background:
            linear-gradient(135deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0.045)),
            rgba(18, 22, 26, 0.72);
        box-shadow: 0 28px 90px rgba(0, 0, 0, 0.32);
        overflow: hidden;
        position: relative;
    }

    .error-hero::before {
        content: "";
        position: absolute;
        inset: 0;
        background:
            linear-gradient(90deg, transparent, rgba(55, 217, 255, 0.12), transparent),
            radial-gradient(circle at 15% 20%, rgba(255, 83, 103, 0.2), transparent 30%);
        transform: translateX(-100%);
        animation: errorScan 6s ease-in-out infinite;
        pointer-events: none;
    }

    .error-copy {
        position: relative;
        z-index: 1;
    }

    .error-copy h1 {
        max-width: 620px;
        margin-top: 10px;
        font-size: clamp(42px, 7vw, 78px);
        line-height: 0.96;
        letter-spacing: 0;
    }

    .error-message {
        max-width: 580px;
        margin-top: 20px;
        color: var(--muted);
        font-size: 18px;
    }

    .error-code {
        width: min(100%, 360px);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-top: 28px;
        padding: 16px 18px;
        border: 1px solid rgba(55, 217, 255, 0.28);
        border-radius: 18px;
        background: rgba(20, 24, 28, 0.78);
    }

    .error-code span {
        color: var(--muted);
        font-size: 13px;
        font-weight: 800;
        text-transform: uppercase;
    }

    .error-code strong {
        color: var(--cyan);
        font-size: 42px;
        line-height: 1;
        letter-spacing: 0;
        text-shadow: 0 0 24px rgba(55, 217, 255, 0.44);
    }

    .error-request {
        max-width: 100%;
        margin-top: 18px;
        color: var(--muted);
        font-size: 14px;
    }

    .error-request code {
        display: inline-block;
        max-width: 100%;
        margin-left: 8px;
        padding: 4px 8px;
        border-radius: 8px;
        color: var(--text);
        background: rgba(255, 255, 255, 0.08);
        overflow-wrap: anywhere;
    }

    .error-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 30px;
    }

    .error-stage {
        min-height: 440px;
        position: relative;
        isolation: isolate;
    }

    .signal-grid {
        position: absolute;
        inset: 12%;
        border-radius: 36px;
        background:
            linear-gradient(rgba(255, 255, 255, 0.08) 1px, transparent 1px),
            linear-gradient(90deg, rgba(255, 255, 255, 0.08) 1px, transparent 1px);
        background-size: 28px 28px;
        mask-image: radial-gradient(circle, black 45%, transparent 72%);
        animation: gridDrift 9s linear infinite;
        opacity: 0.5;
    }

    .signal-orbit,
    .signal-wave {
        position: absolute;
        inset: 50%;
        border-radius: 999px;
        transform: translate(-50%, -50%);
    }

    .signal-orbit {
        border: 1px solid rgba(55, 217, 255, 0.28);
        box-shadow: inset 0 0 35px rgba(55, 217, 255, 0.12), 0 0 42px rgba(55, 217, 255, 0.16);
        animation: orbitPulse 3.8s ease-in-out infinite;
    }

    .orbit-one {
        width: 360px;
        height: 360px;
    }

    .orbit-two {
        width: 270px;
        height: 270px;
        animation-delay: -1.1s;
        border-color: rgba(255, 63, 115, 0.28);
    }

    .orbit-three {
        width: 170px;
        height: 170px;
        animation-delay: -2.2s;
    }

    .esim-card {
        position: absolute;
        left: 50%;
        top: 50%;
        width: 210px;
        aspect-ratio: 0.72;
        border: 1px solid rgba(255, 255, 255, 0.22);
        border-radius: 30px;
        background:
            linear-gradient(155deg, rgba(255, 255, 255, 0.24), rgba(255, 255, 255, 0.06)),
            linear-gradient(135deg, rgba(55, 217, 255, 0.25), rgba(255, 63, 115, 0.2));
        box-shadow: 0 28px 80px rgba(0, 0, 0, 0.36), 0 0 55px rgba(55, 217, 255, 0.26);
        transform: translate(-50%, -50%) rotate(-8deg);
        animation: cardSignal 4.5s ease-in-out infinite;
        overflow: hidden;
        z-index: 2;
    }

    .esim-card::before {
        content: "";
        position: absolute;
        left: 20px;
        top: 20px;
        width: 64px;
        height: 52px;
        border: 2px solid rgba(247, 251, 255, 0.68);
        border-radius: 14px;
        background: rgba(20, 24, 28, 0.34);
    }

    .esim-card::after {
        content: "";
        position: absolute;
        inset: auto 18px 18px;
        height: 6px;
        border-radius: 999px;
        background: linear-gradient(90deg, var(--cyan), var(--blue), var(--pink));
        animation: signalLoad 2.2s ease-in-out infinite;
    }

    .esim-card img {
        position: absolute;
        right: 20px;
        top: 22px;
        width: 58px;
        height: 58px;
        object-fit: contain;
        filter: drop-shadow(0 10px 25px rgba(0, 0, 0, 0.28));
    }

    .chip-line {
        position: absolute;
        left: 28px;
        height: 3px;
        border-radius: 999px;
        background: rgba(247, 251, 255, 0.72);
    }

    .chip-line-one {
        top: 108px;
        width: 112px;
    }

    .chip-line-two {
        top: 128px;
        width: 148px;
    }

    .chip-line-three {
        top: 148px;
        width: 86px;
    }

    .signal-wave {
        width: 70px;
        height: 70px;
        border: 2px solid rgba(55, 217, 255, 0.55);
        animation: waveBurst 2.6s ease-out infinite;
        z-index: 1;
    }

    .wave-two {
        animation-delay: 0.75s;
        border-color: rgba(255, 83, 103, 0.48);
    }

    .wave-three {
        animation-delay: 1.5s;
    }

    .spark {
        position: absolute;
        width: 12px;
        height: 12px;
        border-radius: 999px;
        background: var(--cyan);
        box-shadow: 0 0 24px var(--cyan);
        animation: sparkFloat 3.8s ease-in-out infinite;
    }

    .spark-one {
        left: 16%;
        top: 24%;
    }

    .spark-two {
        right: 18%;
        top: 18%;
        width: 9px;
        height: 9px;
        background: var(--pink);
        box-shadow: 0 0 24px var(--pink);
        animation-delay: -1s;
    }

    .spark-three {
        right: 14%;
        bottom: 22%;
        animation-delay: -2s;
    }

    .spark-four {
        left: 21%;
        bottom: 18%;
        width: 8px;
        height: 8px;
        background: #fff;
        box-shadow: 0 0 18px #fff;
        animation-delay: -2.8s;
    }

    @@keyframes errorScan {
        0%, 30% {
            transform: translateX(-100%);
            opacity: 0;
        }

        45%, 65% {
            opacity: 1;
        }

        100% {
            transform: translateX(100%);
            opacity: 0;
        }
    }

    @@keyframes gridDrift {
        to {
            background-position: 28px 56px;
        }
    }

    @@keyframes orbitPulse {
        0%, 100% {
            opacity: 0.55;
            transform: translate(-50%, -50%) scale(0.96);
        }

        50% {
            opacity: 1;
            transform: translate(-50%, -50%) scale(1.04);
        }
    }

    @@keyframes cardSignal {
        0%, 100% {
            transform: translate(-50%, -50%) rotate(-8deg) translateY(0);
        }

        50% {
            transform: translate(-50%, -50%) rotate(5deg) translateY(-16px);
        }
    }

    @@keyframes signalLoad {
        0%, 100% {
            transform: scaleX(0.32);
            transform-origin: left;
            opacity: 0.65;
        }

        50% {
            transform: scaleX(1);
            opacity: 1;
        }
    }

    @@keyframes waveBurst {
        0% {
            opacity: 0.7;
            transform: translate(-50%, -50%) scale(0.7);
        }

        100% {
            opacity: 0;
            transform: translate(-50%, -50%) scale(5.6);
        }
    }

    @@keyframes sparkFloat {
        0%, 100% {
            transform: translate3d(0, 0, 0) scale(1);
            opacity: 0.72;
        }

        50% {
            transform: translate3d(14px, -20px, 0) scale(1.35);
            opacity: 1;
        }
    }

    @@media (max-width: 860px) {
        .error-hero {
            grid-template-columns: 1fr;
            padding: 32px;
        }

        .error-stage {
            min-height: 360px;
            order: -1;
        }

        .orbit-one {
            width: min(82vw, 330px);
            height: min(82vw, 330px);
        }

        .orbit-two {
            width: min(66vw, 250px);
            height: min(66vw, 250px);
        }
    }

    @@media (max-width: 560px) {
        .error-shell {
            width: min(100% - 24px, 1120px);
            padding: 42px 0 54px;
        }

        .error-hero {
            padding: 24px;
            border-radius: 22px;
        }

        .error-stage {
            min-height: 300px;
        }

        .esim-card {
            width: 160px;
            border-radius: 24px;
        }

        .esim-card img {
            width: 44px;
            height: 44px;
        }

        .chip-line-one {
            top: 88px;
            width: 90px;
        }

        .chip-line-two {
            top: 106px;
            width: 112px;
        }

        .chip-line-three {
            top: 124px;
            width: 72px;
        }

        .error-actions,
        .error-actions .button {
            width: 100%;
        }
    }
</style>
