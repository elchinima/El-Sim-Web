@model AdminSliderListViewModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Sliders - El-Sim Admin";
    var sliderLanguages = new[] { "en", "ru", "az" };
    var sliderLanguageNames = new Dictionary<string, string>
    {
        ["en"] = "English",
        ["ru"] = "Russian",
        ["az"] = "Azerbaijani"
    };
    var canUploadAny = sliderLanguages.Any(language =>
        Model.DesktopSliders.Count(slider => slider.Language == language) < 6 ||
        Model.MobileSliders.Count(slider => slider.Language == language) < 6);
    var visibleLanguages = Model.FilterLanguage == "all"
        ? sliderLanguages
        : sliderLanguages.Where(language => language == Model.FilterLanguage).ToArray();
    var showDesktop = Model.FilterDevice is "all" or "desktop";
    var showMobile = Model.FilterDevice is "all" or "mobile";
}

<main class="admin-shell">
  <section class="admin-hero" aria-labelledby="admin-sliders-title">
    <div>
      <p class="eyebrow">home carousel</p>
      <h1 id="admin-sliders-title">Sliders</h1>
      <p>Upload desktop and mobile carousel images for the home page.</p>
    </div>
    <a class="button button-secondary" href="/admin/dashboard"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 13h6V4H4v9Z"></path><path d="M14 20h6V4h-6v16Z"></path><path d="M4 20h6v-3H4v3Z"></path></svg><span class="button-text">Dashboard</span></a>
  </section>

  @if (TempData["AdminMessage"] is string adminMessage)
  {
    <div class="admin-message">@adminMessage</div>
  }

  @if (TempData["AdminError"] is string adminError)
  {
    <div class="admin-message is-error">@adminError</div>
  }

  <section class="admin-panel admin-slider-upload-panel" aria-label="Upload slider">
    <div class="admin-panel-head">
      <div>
        <p class="eyebrow">upload</p>
        <h2>Add slider</h2>
      </div>
      <span>png, jpg, gif up to 3 MB, max 6 each</span>
    </div>

    <form method="post" asp-action="AddSlider" enctype="multipart/form-data" class="admin-slider-upload-form">
      @Html.AntiForgeryToken()
      <div class="field admin-slider-file-field">
        <span class="field-label">Image</span>
        <label class="file-drop-zone" for="sliderImage">
          <input id="sliderImage" name="sliderImage" type="file" accept=".png,.jpg,.jpeg,.gif,image/png,image/jpeg,image/gif" data-max-file-size="3145728" data-max-file-size-text="3 MB" @(canUploadAny ? "" : "disabled")>
          <span class="file-drop-preview"></span>
          <span class="file-drop-title">Drop slider here</span>
          <span class="file-drop-text">or choose PNG, JPG, GIF up to 3 MB</span>
        </label>
      </div>
      <div class="field">
        <label for="language">Language</label>
        <select id="language" name="language">
          <option value="all">All languages</option>
          <option value="en">English</option>
          <option value="ru">Russian</option>
          <option value="az">Azerbaijani</option>
        </select>
      </div>
      <div class="field">
        <label for="altText">Alt text</label>
        <input id="altText" name="altText" maxlength="160">
      </div>
      <label class="admin-featured-toggle admin-slider-type-toggle">
        <input name="isMobile" type="checkbox" value="true">
        <span>Mobile 3:4</span>
      </label>
      <button class="button button-secondary" type="button" data-clear-file><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18"></path><path d="M8 6V4h8v2"></path><path d="m19 6-1 14H6L5 6"></path></svg><span class="button-text">Clear field</span></button>
      <button class="button button-primary" type="submit" @(canUploadAny ? "" : "disabled")><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 16V4"></path><path d="m7 9 5-5 5 5"></path><path d="M4 20h16"></path></svg><span class="button-text">Upload</span></button>
    </form>
  </section>

  <section class="admin-panel admin-slider-panel" aria-label="Slider filters">
    <div class="admin-panel-head">
      <div>
        <p class="eyebrow">filters</p>
        <h2>Filter sliders</h2>
      </div>
    </div>
    <form class="admin-search" method="get" asp-action="Sliders">
      <div class="field">
        <label for="device">Version</label>
        <select id="device" name="device">
          <option value="all" selected="@(Model.FilterDevice == "all")">All versions</option>
          <option value="desktop" selected="@(Model.FilterDevice == "desktop")">Desktop</option>
          <option value="mobile" selected="@(Model.FilterDevice == "mobile")">Mobile</option>
        </select>
      </div>
      <div class="field">
        <label for="filter-language">Language</label>
        <select id="filter-language" name="language">
          <option value="all" selected="@(Model.FilterLanguage == "all")">All languages</option>
          <option value="en" selected="@(Model.FilterLanguage == "en")">English</option>
          <option value="ru" selected="@(Model.FilterLanguage == "ru")">Russian</option>
          <option value="az" selected="@(Model.FilterLanguage == "az")">Azerbaijani</option>
        </select>
      </div>
      <div class="admin-filter-actions">
        <button class="button button-primary" type="submit"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5h18"></path><path d="M6 12h12"></path><path d="M10 19h4"></path></svg><span class="button-text">Filter</span></button>
        <a class="button button-secondary" href="/admin/sliders"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4v6h6"></path><path d="M20 20v-6h-6"></path><path d="M20 9A8 8 0 0 0 6 5.5L4 10"></path><path d="M4 15a8 8 0 0 0 14 3.5L20 14"></path></svg><span class="button-text">Clear</span></a>
      </div>
    </form>
  </section>

  <form method="post" asp-action="UpdateSliders" class="admin-product-form" data-confirm-message="Save slider changes?" data-confirm-button="Save">
    @Html.AntiForgeryToken()

    @foreach (var language in visibleLanguages)
    {
      var desktopCount = Model.DesktopSliders.Count(slider => slider.Language == language);
      var mobileCount = Model.MobileSliders.Count(slider => slider.Language == language);

      @if (showDesktop)
      {
      <section class="admin-panel admin-slider-panel" aria-label="@sliderLanguageNames[language] desktop sliders">
        <div class="admin-panel-head">
          <div>
            <p class="eyebrow">@sliderLanguageNames[language]</p>
            <h2>Desktop 16:9</h2>
          </div>
          <span>@desktopCount / 6 sliders</span>
        </div>

        <div class="admin-slider-list">
          @if (desktopCount == 0)
          {
            <p class="admin-empty">No desktop sliders.</p>
          }

          @for (var index = 0; index < Model.DesktopSliders.Count; index++)
          {
            if (Model.DesktopSliders[index].Language != language)
            {
              continue;
            }

            <article class="admin-slider-row">
              <input type="hidden" asp-for="DesktopSliders[index].Id">
              <img src="@Model.DesktopSliders[index].ImagePath" alt="@Model.DesktopSliders[index].AltText">
              <div class="admin-slider-fields">
                <div class="field">
                  <label asp-for="DesktopSliders[index].AltText">Alt text</label>
                  <input asp-for="DesktopSliders[index].AltText" maxlength="160">
                </div>
                <div class="field">
                  <label asp-for="DesktopSliders[index].SortOrder">Sort order</label>
                  <input asp-for="DesktopSliders[index].SortOrder" type="number">
                </div>
              </div>
              <div class="admin-slider-row-actions">
                <button class="button button-secondary" type="button" data-product-modal-open="update-slider-@Model.DesktopSliders[index].Id"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 16V4"></path><path d="m7 9 5-5 5 5"></path><path d="M4 20h16"></path></svg><span class="button-text">Update</span></button>
                <button class="button button-danger" type="submit" form="delete-slider-@Model.DesktopSliders[index].Id"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18"></path><path d="M8 6V4h8v2"></path><path d="m19 6-1 14H6L5 6"></path></svg><span class="button-text">Delete</span></button>
              </div>
            </article>
          }
        </div>
      </section>
      }

      @if (showMobile)
      {
      <section class="admin-panel admin-slider-panel" aria-label="@sliderLanguageNames[language] mobile sliders">
        <div class="admin-panel-head">
          <div>
            <p class="eyebrow">@sliderLanguageNames[language]</p>
            <h2>Mobile 3:4</h2>
          </div>
          <span>@mobileCount / 6 sliders</span>
        </div>

        <div class="admin-slider-list">
          @if (mobileCount == 0)
          {
            <p class="admin-empty">No mobile sliders.</p>
          }

          @for (var index = 0; index < Model.MobileSliders.Count; index++)
          {
            if (Model.MobileSliders[index].Language != language)
            {
              continue;
            }

            <article class="admin-slider-row is-mobile">
              <input type="hidden" asp-for="MobileSliders[index].Id">
              <img src="@Model.MobileSliders[index].ImagePath" alt="@Model.MobileSliders[index].AltText">
              <div class="admin-slider-fields">
                <div class="field">
                  <label asp-for="MobileSliders[index].AltText">Alt text</label>
                  <input asp-for="MobileSliders[index].AltText" maxlength="160">
                </div>
                <div class="field">
                  <label asp-for="MobileSliders[index].SortOrder">Sort order</label>
                  <input asp-for="MobileSliders[index].SortOrder" type="number">
                </div>
              </div>
              <div class="admin-slider-row-actions">
                <button class="button button-secondary" type="button" data-product-modal-open="update-slider-@Model.MobileSliders[index].Id"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 16V4"></path><path d="m7 9 5-5 5 5"></path><path d="M4 20h16"></path></svg><span class="button-text">Update</span></button>
                <button class="button button-danger" type="submit" form="delete-slider-@Model.MobileSliders[index].Id"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18"></path><path d="M8 6V4h8v2"></path><path d="m19 6-1 14H6L5 6"></path></svg><span class="button-text">Delete</span></button>
              </div>
            </article>
          }
        </div>
      </section>
      }
    }

    <div class="admin-sticky-actions">
      <button class="button button-primary" type="submit"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z"></path><path d="M17 21v-8H7v8"></path><path d="M7 3v5h8"></path></svg><span class="button-text">Save sliders</span></button>
    </div>
  </form>

  @foreach (var slider in Model.DesktopSliders.Concat(Model.MobileSliders))
  {
    <form id="delete-slider-@slider.Id" method="post" asp-action="DeleteSlider" asp-route-id="@slider.Id" data-confirm-message="Delete this slider?" data-confirm-button="Delete">
      @Html.AntiForgeryToken()
    </form>

    <dialog class="admin-product-modal admin-slider-modal" id="update-slider-@slider.Id">
      <form method="post" asp-action="UpdateSliderImage" asp-route-id="@slider.Id" enctype="multipart/form-data" class="admin-product-modal-box" data-confirm-message="Update this slider image?" data-confirm-button="Update">
        @Html.AntiForgeryToken()
        <div class="admin-panel-head">
          <div>
            <p class="eyebrow">@slider.Language.ToUpperInvariant() @(slider.IsMobile ? "mobile" : "desktop")</p>
            <h2>Update slider</h2>
          </div>
          <button class="button button-secondary" type="button" data-product-modal-close><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg><span class="button-text">Close</span></button>
        </div>

        <div class="admin-slider-update-grid">
          <img src="@slider.ImagePath" alt="@slider.AltText">
          <div class="field admin-slider-file-field">
            <span class="field-label">New image</span>
            <label class="file-drop-zone" for="sliderImage-@slider.Id">
              <input id="sliderImage-@slider.Id" name="sliderImage" type="file" accept=".png,.jpg,.jpeg,.gif,image/png,image/jpeg,image/gif" data-max-file-size="3145728" data-max-file-size-text="3 MB">
              <span class="file-drop-preview"></span>
              <span class="file-drop-title">Drop slider here</span>
              <span class="file-drop-text">or choose PNG, JPG, GIF up to 3 MB</span>
            </label>
          </div>
        </div>

        <div class="admin-slider-modal-actions">
          <button class="button button-secondary" type="button" data-clear-file><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18"></path><path d="M8 6V4h8v2"></path><path d="m19 6-1 14H6L5 6"></path></svg><span class="button-text">Clear field</span></button>
          <button class="button button-primary" type="submit"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 16V4"></path><path d="m7 9 5-5 5 5"></path><path d="M4 20h16"></path></svg><span class="button-text">Update</span></button>
        </div>
      </form>
    </dialog>
  }
</main>
