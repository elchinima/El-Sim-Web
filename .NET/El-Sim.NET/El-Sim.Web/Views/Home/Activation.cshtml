@model ActivationPageViewModel

@{
    ViewData["Title"] = "Activation - El-Sim";
}

<main>
  <section class="pass-hero activation-hero" aria-labelledby="activation-title">
    <p class="eyebrow" data-product-i18n data-lang-en="Activation" data-lang-ru="Активация" data-lang-az="Aktivasiya">Activation</p>
    <h1 id="activation-title" data-product-i18n data-lang-en="Activation" data-lang-ru="Активация" data-lang-az="Aktivasiya">Activation</h1>
  </section>

  @if (TempData["ActivationError"] is string activationError)
  {
    <section class="section">
      <div class="admin-message is-error">@activationError</div>
    </section>
  }

  <section class="section" aria-label="Regular numbers">
    <div class="section-head">
      <p class="eyebrow" data-product-i18n data-lang-en="Regular" data-lang-ru="Обычный" data-lang-az="Adi">Regular</p>
      <h2 data-product-i18n data-lang-en="Regular number" data-lang-ru="Обычный номер" data-lang-az="Adi nömrə">Regular number</h2>
    </div>
    <div class="plans-grid">
      @foreach (var prefix in Model.PrefixPrices)
      {
        var totalAzn = prefix.BasicCurrency == "USD" && Model.ExchangeRate is not null
          ? decimal.Round(prefix.BasicPrice * Model.ExchangeRate.UsdToAzn * 1.03m, 2, MidpointRounding.AwayFromZero)
          : prefix.BasicPrice;
        var confirmMessage = prefix.BasicCurrency == "USD" && Model.ExchangeRate is not null
          ? $"Buy +994 {prefix.Prefix} number for {totalAzn:F2} AZN? USD rate: {Model.ExchangeRate.UsdToAzn:F4}, conversion commission: 3%."
          : $"Buy +994 {prefix.Prefix} number for {prefix.BasicPrice:F2} {prefix.BasicCurrency}?";
        var confirmMessageRu = prefix.BasicCurrency == "USD" && Model.ExchangeRate is not null
          ? $"Купить номер +994 {prefix.Prefix} за {totalAzn:F2} AZN? Курс USD: {Model.ExchangeRate.UsdToAzn:F4}, комиссия конвертации: 3%."
          : $"Купить номер +994 {prefix.Prefix} за {prefix.BasicPrice:F2} {prefix.BasicCurrency}?";
        var confirmMessageAz = prefix.BasicCurrency == "USD" && Model.ExchangeRate is not null
          ? $"+994 {prefix.Prefix} nomresi {totalAzn:F2} AZN qiymetine alinsin? USD kursu: {Model.ExchangeRate.UsdToAzn:F4}, konvertasiya komissiyasi: 3%."
          : $"+994 {prefix.Prefix} nomresi {prefix.BasicPrice:F2} {prefix.BasicCurrency} qiymetine alinsin?";
        <article class="pass-card activation-card">
          <div>
            <h2>+994 @prefix.Prefix</h2>
            <p class="pass-price">@prefix.BasicPrice.ToString("F2", CultureInfo.InvariantCulture) @prefix.BasicCurrency</p>
            @if (prefix.BasicCurrency == "USD" && Model.ExchangeRate is not null)
            {
              <p class="conversion-note" data-product-i18n data-lang-en="@($"~ {totalAzn:F2} AZN | USD rate {Model.ExchangeRate.UsdToAzn:F4} + 3% conversion fee")" data-lang-ru="@($"~ {totalAzn:F2} AZN | курс USD {Model.ExchangeRate.UsdToAzn:F4} + комиссия 3%")" data-lang-az="@($"~ {totalAzn:F2} AZN | USD kursu {Model.ExchangeRate.UsdToAzn:F4} + 3% komissiya")">~ @totalAzn.ToString("F2", CultureInfo.InvariantCulture) AZN | USD rate @Model.ExchangeRate.UsdToAzn.ToString("F4", CultureInfo.InvariantCulture) + 3% conversion fee</p>
            }
          </div>
          <form method="post" asp-action="PurchaseNumber" data-confirm-message="@confirmMessage" data-confirm-message-ru="@confirmMessageRu" data-confirm-message-az="@confirmMessageAz" data-confirm-button="Buy">
            @Html.AntiForgeryToken()
            <input type="hidden" name="prefix" value="@prefix.Prefix">
            <input type="hidden" name="isGlobal" value="false">
            <button class="plan-link" type="submit" data-product-i18n data-lang-en="Buy" data-lang-ru="Купить" data-lang-az="Al">Buy</button>
          </form>
        </article>
      }
    </div>
  </section>

  <section class="section" aria-label="Global numbers">
    <div class="section-head">
      <p class="eyebrow" data-product-i18n data-lang-en="Global" data-lang-ru="Глобальный" data-lang-az="Qlobal">Global</p>
      <h2 data-product-i18n data-lang-en="Global number" data-lang-ru="Глобальный номер" data-lang-az="Qlobal nömrə">Global number</h2>
    </div>
    <div class="plans-grid">
      @foreach (var prefix in Model.PrefixPrices.Where(item => item.SupportsGlobal))
      {
        var totalAzn = prefix.GlobalCurrency == "USD" && Model.ExchangeRate is not null
          ? decimal.Round(prefix.GlobalPrice * Model.ExchangeRate.UsdToAzn * 1.03m, 2, MidpointRounding.AwayFromZero)
          : prefix.GlobalPrice;
        var confirmMessage = prefix.GlobalCurrency == "USD" && Model.ExchangeRate is not null
          ? $"Buy global +994 {prefix.Prefix} number for {totalAzn:F2} AZN? USD rate: {Model.ExchangeRate.UsdToAzn:F4}, conversion commission: 3%."
          : $"Buy global +994 {prefix.Prefix} number for {prefix.GlobalPrice:F2} {prefix.GlobalCurrency}?";
        var confirmMessageRu = prefix.GlobalCurrency == "USD" && Model.ExchangeRate is not null
          ? $"Купить глобальный номер +994 {prefix.Prefix} за {totalAzn:F2} AZN? Курс USD: {Model.ExchangeRate.UsdToAzn:F4}, комиссия конвертации: 3%."
          : $"Купить глобальный номер +994 {prefix.Prefix} за {prefix.GlobalPrice:F2} {prefix.GlobalCurrency}?";
        var confirmMessageAz = prefix.GlobalCurrency == "USD" && Model.ExchangeRate is not null
          ? $"Qlobal +994 {prefix.Prefix} nomresi {totalAzn:F2} AZN qiymetine alinsin? USD kursu: {Model.ExchangeRate.UsdToAzn:F4}, konvertasiya komissiyasi: 3%."
          : $"Qlobal +994 {prefix.Prefix} nomresi {prefix.GlobalPrice:F2} {prefix.GlobalCurrency} qiymetine alinsin?";
        <article class="pass-card activation-card is-featured">
          <span class="favorite-badge" data-product-i18n data-lang-en="Global" data-lang-ru="Глобальный" data-lang-az="Qlobal">Global</span>
          <div>
            <h2>+994 @prefix.Prefix ... G</h2>
            <p class="pass-price">@prefix.GlobalPrice.ToString("F2", CultureInfo.InvariantCulture) @prefix.GlobalCurrency</p>
            @if (prefix.GlobalCurrency == "USD" && Model.ExchangeRate is not null)
            {
              <p class="conversion-note" data-product-i18n data-lang-en="@($"~ {totalAzn:F2} AZN | USD rate {Model.ExchangeRate.UsdToAzn:F4} + 3% conversion fee")" data-lang-ru="@($"~ {totalAzn:F2} AZN | курс USD {Model.ExchangeRate.UsdToAzn:F4} + комиссия 3%")" data-lang-az="@($"~ {totalAzn:F2} AZN | USD kursu {Model.ExchangeRate.UsdToAzn:F4} + 3% komissiya")">~ @totalAzn.ToString("F2", CultureInfo.InvariantCulture) AZN | USD rate @Model.ExchangeRate.UsdToAzn.ToString("F4", CultureInfo.InvariantCulture) + 3% conversion fee</p>
            }
          </div>
          <form method="post" asp-action="PurchaseNumber" data-confirm-message="@confirmMessage" data-confirm-message-ru="@confirmMessageRu" data-confirm-message-az="@confirmMessageAz" data-confirm-button="Buy">
            @Html.AntiForgeryToken()
            <input type="hidden" name="prefix" value="@prefix.Prefix">
            <input type="hidden" name="isGlobal" value="true">
            <button class="plan-link" type="submit" data-product-i18n data-lang-en="Buy" data-lang-ru="Купить" data-lang-az="Al">Buy</button>
          </form>
        </article>
      }
    </div>
  </section>
</main>
