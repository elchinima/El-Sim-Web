@{
    ViewData["Title"] = "El-Sim - Support";
    ViewData["SupportChrome"] = true;
}

<main class="support-chat-shell">
  <section class="support-chat-hero">
    <div>
      <p class="eyebrow">support chat</p>
      <h1>How can we help?</h1>
    </div>
    <div class="support-chat-status is-idle" aria-label="Support status" data-support-status>
      <span></span>
      <strong data-support-status-text data-no-translate>No request</strong>
    </div>
  </section>

  <section class="support-chat-panel" data-support-chat>
    <div class="support-chat-head">
      <div class="support-chat-agent">
        <span class="support-chat-avatar" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d="M4 12a8 8 0 0 1 16 0v4a2 2 0 0 1-2 2h-2"></path>
            <path d="M6 13v3a2 2 0 0 0 2 2"></path>
            <path d="M18 13v3"></path>
            <path d="M9 19h6"></path>
          </svg>
        </span>
        <div>
          <h2>El-Sim Support</h2>
          <p data-agent-label data-no-translate hidden></p>
        </div>
      </div>
      <div class="support-chat-actions">
        <a class="support-chat-history" href="/support/chats" data-no-translate>History</a>
      </div>
    </div>

    <div class="support-chat-messages" data-chat-messages aria-live="polite">
      <article class="chat-message chat-message-bot">
        <span class="chat-message-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d="M4 12a8 8 0 0 1 16 0v4a2 2 0 0 1-2 2h-2"></path>
            <path d="M9 19h6"></path>
            <path d="M8 13h.01"></path>
            <path d="M12 13h.01"></path>
            <path d="M16 13h.01"></path>
          </svg>
        </span>
        <div>
          <p>Hello! Tell us what happened, and we will guide you step by step.</p>
          <time>Now</time>
        </div>
      </article>
    </div>

    <form class="support-chat-form" data-chat-form autocomplete="off">
      <div class="support-chat-waiting" data-chat-waiting hidden>
        <span data-chat-waiting-text data-no-translate>Please wait for operator connection</span>
        <i></i><i></i><i></i>
      </div>
      <div class="support-chat-attachment-preview" data-attachment-preview hidden>
        <button type="button" data-attachment-open aria-label="Open image preview">
          <img src="" alt="Attached image">
        </button>
        <button type="button" data-attachment-remove aria-label="Remove image">×</button>
      </div>
      <label class="support-chat-input-wrap" for="support-chat-input">
        <span class="support-chat-input-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z"></path>
          </svg>
        </span>
        <input id="support-chat-input" type="text" data-chat-input data-no-translate placeholder="Type your message" maxlength="260">
      </label>
      <label class="support-chat-attach" aria-label="Attach image" title="Attach image">
        <input type="file" data-chat-image accept="image/jpeg,image/jpg,image/png">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M21.4 11.6 12 21a6 6 0 0 1-8.5-8.5l9.8-9.8a4 4 0 0 1 5.7 5.7l-9.8 9.8a2 2 0 0 1-2.8-2.8l9.4-9.4"></path>
        </svg>
      </label>
      <button class="support-chat-send" type="submit" aria-label="Send message" title="Send message">
        <span data-no-translate>Send</span>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="m22 2-7 20-4-9-9-4Z"></path>
          <path d="M22 2 11 13"></path>
        </svg>
      </button>
    </form>
    <dialog class="support-image-dialog" data-attachment-dialog>
      <button type="button" data-attachment-close aria-label="Close preview">×</button>
      <img src="" alt="Attached image preview">
    </dialog>
  </section>
</main>
