@{
    ViewData["Title"] = "El-Sim - Support";
    ViewData["SupportChrome"] = true;
}

<main class="support-chat-shell">
  <section class="support-chat-hero">
    <div>
      <p class="eyebrow">support chat</p>
      <h1>How can we help?</h1>
    </div>
    <div class="support-chat-status" aria-label="Support status">
      <span></span>
      <strong>Online</strong>
    </div>
  </section>

  <section class="support-chat-panel" data-support-chat>
    <div class="support-chat-head">
      <div class="support-chat-agent">
        <span class="support-chat-avatar" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d="M4 12a8 8 0 0 1 16 0v4a2 2 0 0 1-2 2h-2"></path>
            <path d="M6 13v3a2 2 0 0 0 2 2"></path>
            <path d="M18 13v3"></path>
            <path d="M9 19h6"></path>
          </svg>
        </span>
        <div>
          <h2>El-Sim Support</h2>
          <p data-agent-label data-no-translate hidden></p>
        </div>
      </div>
      <div class="support-chat-actions">
        <button class="support-chat-history" type="button" data-chat-history-toggle data-no-translate>History</button>
        <div class="support-chat-badge">
          <span></span>
          <strong data-ai-badge data-no-translate>AI assistant</strong>
        </div>
      </div>
    </div>

    <div class="support-chat-messages" data-chat-messages aria-live="polite">
      <article class="chat-message chat-message-bot">
        <span class="chat-message-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d="M4 12a8 8 0 0 1 16 0v4a2 2 0 0 1-2 2h-2"></path>
            <path d="M9 19h6"></path>
            <path d="M8 13h.01"></path>
            <path d="M12 13h.01"></path>
            <path d="M16 13h.01"></path>
          </svg>
        </span>
        <div>
          <p>Hello! Tell us what happened, and we will guide you step by step.</p>
          <time>Now</time>
        </div>
      </article>
    </div>

    <form class="support-chat-form" data-chat-form autocomplete="off">
      <label class="support-chat-input-wrap" for="support-chat-input">
        <span class="support-chat-input-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z"></path>
          </svg>
        </span>
        <input id="support-chat-input" type="text" data-chat-input data-no-translate placeholder="Type your message" maxlength="260" required>
      </label>
      <button class="support-chat-send" type="submit" aria-label="Send message" title="Send message">
        <span data-no-translate>Send</span>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="m22 2-7 20-4-9-9-4Z"></path>
          <path d="M22 2 11 13"></path>
        </svg>
      </button>
    </form>
  </section>
</main>
