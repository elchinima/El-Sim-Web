@model HomeProductsViewModel

@{
    ViewData["Title"] = "El-Sim - eSIM Operator";
    var sliderLanguages = new[] { "en", "ru", "az" };
}

<main class="home-page">
    @foreach (var language in sliderLanguages)
    {
      var desktopSliders = Model.DesktopSliders.Where(slider => slider.Language == language).ToList();
      var mobileSliders = Model.MobileSliders.Where(slider => slider.Language == language).ToList();

      @if (desktopSliders.Count > 0)
      {
        <section class="top-slider top-slider-desktop" aria-label="El-Sim desktop highlights" data-active="0" data-lang-slider="@language" data-slider-device="desktop" @(language == "en" ? "" : "hidden")>
          <div class="slider-track">
            @foreach (var slider in desktopSliders)
            {
              <article class="slider-slide">
                <img src="@slider.ImagePath" alt="@slider.AltText" draggable="false">
              </article>
            }
          </div>

          @if (desktopSliders.Count > 1)
          {
            <div class="slider-dots" aria-hidden="true">
              @for (var index = 0; index < desktopSliders.Count; index++)
              {
                <span class="@(index == 0 ? "is-active" : "")"></span>
              }
            </div>
          }
        </section>
      }

      @if (mobileSliders.Count > 0)
      {
        <section class="top-slider top-slider-mobile" aria-label="El-Sim mobile highlights" data-active="0" data-lang-slider="@language" data-slider-device="mobile" @(language == "en" && desktopSliders.Count == 0 ? "" : "hidden")>
          <div class="slider-track">
            @foreach (var slider in mobileSliders)
            {
              <article class="slider-slide">
                <img src="@slider.ImagePath" alt="@slider.AltText" draggable="false">
              </article>
            }
          </div>

          @if (mobileSliders.Count > 1)
          {
            <div class="slider-dots" aria-hidden="true">
              @for (var index = 0; index < mobileSliders.Count; index++)
              {
                <span class="@(index == 0 ? "is-active" : "")"></span>
              }
            </div>
          }
        </section>
      }
    }

    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow">digital SIM for Azerbaijan</p>
        <h1>Mobile connection without a plastic SIM card</h1>
        <p class="hero-text">Choose a plan, get your QR code, and activate El-Sim on your phone in just a few minutes.
        </p>

        <div class="hero-actions">
          <a class="button button-primary" href="#plans">Choose a plan</a>
          <a class="button button-secondary" href="#steps">How it works</a>
        </div>

        <div class="hero-stats" aria-label="Benefits">
          <div>
            <strong>2 min</strong>
            <span>activation</span>
          </div>
          <div>
            <strong>5G</strong>
            <span>speed</span>
          </div>
          <div>
            <strong>24/7</strong>
            <span>support</span>
          </div>
        </div>
      </div>

      <div class="hero-visual" aria-hidden="true">
        <div class="logo-orbit">
          <img src="/Assets/Image/Logo/El-Sim_Logo_Icon.png" alt="">
        </div>
        <div class="float-card float-card-top">
          <span>QR</span>
          <b>Instant code</b>
        </div>
        <div class="float-card float-card-bottom">
          <span>eSIM</span>
          <b>Active</b>
        </div>
      </div>
    </section>

    <section class="device-strip" id="global" aria-label="Compatible devices">
      <span>Apple</span>
      <span>Samsung</span>
      <span>Pixel</span>
      <span>OPPO</span>
      <span>Vivo</span>
      <span>Nothing</span>
      <span>Xiaomi</span>
      <span>Honor</span>
      <span>Huawei</span>
    </section>

    <section class="section" id="steps">
      <div class="section-head">
        <p class="eyebrow">activation</p>
        <h2>Three simple steps</h2>
      </div>

      <div class="steps-grid">
        <article class="info-card">
          <span class="card-number">01</span>
          <h3>Choose a plan</h3>
          <p>Pick the data package you need and pay online with a convenient method.</p>
        </article>
        <article class="info-card">
          <span class="card-number">02</span>
          <h3>Get your QR code</h3>
          <p>Your activation code arrives by email right after purchase.</p>
        </article>
        <article class="info-card">
          <span class="card-number">03</span>
          <h3>Connect</h3>
          <p>Scan the QR code in your phone settings and stay online.</p>
        </article>
      </div>
    </section>

    <section class="section" id="plans">
      <div class="section-head">
        <p class="eyebrow">plans</p>
        <h2>Simple packages</h2>
      </div>

      <div class="plans-grid">
        @foreach (var product in Model.EsimProducts)
        {
          var totalAzn = product.Currency == "USD" && Model.ExchangeRate is not null
            ? decimal.Round(product.Amount * Model.ExchangeRate.UsdToAzn * 1.03m, 2, MidpointRounding.AwayFromZero)
            : product.TotalAzn;
          var confirmMessage = product.Currency == "USD" && Model.ExchangeRate is not null
            ? $"Buy {product.Name} for {totalAzn:F2} AZN? USD rate: {Model.ExchangeRate.UsdToAzn:F4}, conversion commission: 3%."
            : $"Buy {product.Name} for {product.DisplayPrice}?";
          <article class="pass-card esim-card @(product.IsFeatured ? "is-featured" : "")">
            @if (product.IsFavorite)
            {
              <span class="favorite-badge">Favorite</span>
            }
            <div>
              <h2 data-product-i18n data-lang-en="@product.Name" data-lang-ru="@(string.IsNullOrWhiteSpace(product.NameRu) ? product.Name : product.NameRu)" data-lang-az="@(string.IsNullOrWhiteSpace(product.NameAz) ? product.Name : product.NameAz)">@product.Name</h2>
              @if (!string.IsNullOrWhiteSpace(product.Price) || !string.IsNullOrWhiteSpace(product.Period))
              {
                <p class="pass-price">@if (!string.IsNullOrWhiteSpace(product.Price)) { <span data-product-i18n data-lang-en="@product.DisplayPrice" data-lang-ru="@product.DisplayPriceRu" data-lang-az="@product.DisplayPriceAz">@product.DisplayPrice</span> } @if (!string.IsNullOrWhiteSpace(product.Price) && !string.IsNullOrWhiteSpace(product.Period)) { <span>| </span> } @if (!string.IsNullOrWhiteSpace(product.Period)) { <span data-product-i18n data-lang-en="@product.Period" data-lang-ru="@(string.IsNullOrWhiteSpace(product.PeriodRu) ? product.Period : product.PeriodRu)" data-lang-az="@(string.IsNullOrWhiteSpace(product.PeriodAz) ? product.Period : product.PeriodAz)">@product.Period</span> }</p>
                @if (product.Currency == "USD" && Model.ExchangeRate is not null)
                {
                  <p class="conversion-note" data-product-i18n data-lang-en="@($"~ {totalAzn:F2} AZN | USD rate {Model.ExchangeRate.UsdToAzn:F4} + 3% conversion fee")" data-lang-ru="@($"~ {totalAzn:F2} AZN | курс USD {Model.ExchangeRate.UsdToAzn:F4} + комиссия 3%")" data-lang-az="@($"~ {totalAzn:F2} AZN | USD kursu {Model.ExchangeRate.UsdToAzn:F4} + 3% komissiya")">~ @totalAzn.ToString("F2", CultureInfo.InvariantCulture) AZN | USD rate @Model.ExchangeRate.UsdToAzn.ToString("F4", CultureInfo.InvariantCulture) + 3% conversion fee</p>
                }
              }
            </div>
            @if (product.Features.Count > 0)
            {
              <ul>
                @for (var featureIndex = 0; featureIndex < product.Features.Count; featureIndex++)
                {
                  var feature = product.Features[featureIndex];
                  var featureRu = product.FeaturesRu.Count > featureIndex ? product.FeaturesRu[featureIndex] : feature;
                  var featureAz = product.FeaturesAz.Count > featureIndex ? product.FeaturesAz[featureIndex] : feature;
                  <li data-product-i18n data-lang-en="@feature" data-lang-ru="@featureRu" data-lang-az="@featureAz">@feature</li>
                }
              </ul>
            }
            else if (!string.IsNullOrWhiteSpace(product.Description))
            {
              <ul>
                <li data-product-i18n data-lang-en="@product.Description" data-lang-ru="@(string.IsNullOrWhiteSpace(product.DescriptionRu) ? product.Description : product.DescriptionRu)" data-lang-az="@(string.IsNullOrWhiteSpace(product.DescriptionAz) ? product.Description : product.DescriptionAz)">@product.Description</li>
              </ul>
            }
            @if (!string.IsNullOrWhiteSpace(product.ButtonText))
            {
              <form method="post" asp-action="PurchaseProduct" asp-route-productId="@product.Id" data-confirm-message="@confirmMessage" data-confirm-button="Buy">
                @Html.AntiForgeryToken()
                <button class="plan-link" type="submit" data-product-i18n data-lang-en="@product.ButtonText" data-lang-ru="@(string.IsNullOrWhiteSpace(product.ButtonTextRu) ? product.ButtonText : product.ButtonTextRu)" data-lang-az="@(string.IsNullOrWhiteSpace(product.ButtonTextAz) ? product.ButtonText : product.ButtonTextAz)">@product.ButtonText</button>
              </form>
            }
          </article>
        }
      </div>
    </section>

    <section class="support" id="wifi">
      <div>
        <p class="eyebrow">wi-fi fallback</p>
        <h2>Stay online between networks</h2>
        <p>Use El-Sim support to find nearby Wi-Fi and finish activation when mobile coverage is weak.</p>
      </div>
      <a class="button button-secondary" href="#support">Get help</a>
    </section>

    <section class="support" id="support">
      <div>
        <p class="eyebrow">support</p>
        <h2>We can help you connect</h2>
        <p>Message us if you need device checks, QR code help, or plan recommendations.</p>
      </div>
      <a class="button button-primary" href="#">Contact us</a>
    </section>
  </main>

