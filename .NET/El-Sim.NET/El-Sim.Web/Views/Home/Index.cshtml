@model HomeProductsViewModel

@{
    ViewData["Title"] = "El-Sim - eSIM Operator";
}

<main>
    <section class="top-slider" aria-label="El-Sim highlights" data-active="0">
      <div class="slider-track">
        <article class="slider-slide">
          <img src="/Assets/Image/Slider/Slider_1.png" alt="Digital eSIM card" draggable="false">
          <div class="slider-content">
            <span>El-Sim eSIM</span>
            <h2>Instant mobile access</h2>
            <p>Activate your digital SIM with a QR code and stay connected without plastic cards.</p>
          </div>
        </article>
        <article class="slider-slide">
          <img src="/Assets/Image/Slider/Slider_2.png" alt="Smartphone with eSIM activation" draggable="false">
          <div class="slider-content">
            <span>Fast setup</span>
            <h2>Scan, install, go online</h2>
            <p>A smooth activation flow built for modern phones and everyday travel.</p>
          </div>
        </article>
        <article class="slider-slide">
          <img src="/Assets/Image/Slider/Slider_3.png" alt="Azerbaijan network coverage" draggable="false">
          <div class="slider-content">
            <span>Coverage</span>
            <h2>Made for Azerbaijan</h2>
            <p>Reliable digital connectivity across the city, regions, and the road between them.</p>
          </div>
        </article>
      </div>

      <div class="slider-dots" aria-hidden="true">
        <span class="is-active"></span>
        <span></span>
        <span></span>
      </div>
    </section>

    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow">digital SIM for Azerbaijan</p>
        <h1>Mobile connection without a plastic SIM card</h1>
        <p class="hero-text">Choose a plan, get your QR code, and activate El-Sim on your phone in just a few minutes.
        </p>

        <div class="hero-actions">
          <a class="button button-primary" href="#plans">Choose a plan</a>
          <a class="button button-secondary" href="#steps">How it works</a>
        </div>

        <div class="hero-stats" aria-label="Benefits">
          <div>
            <strong>2 min</strong>
            <span>activation</span>
          </div>
          <div>
            <strong>5G</strong>
            <span>speed</span>
          </div>
          <div>
            <strong>24/7</strong>
            <span>support</span>
          </div>
        </div>
      </div>

      <div class="hero-visual" aria-hidden="true">
        <div class="logo-orbit">
          <img src="/Assets/Image/Logo/El-Sim_Logo_Icon.png" alt="">
        </div>
        <div class="float-card float-card-top">
          <span>QR</span>
          <b>Instant code</b>
        </div>
        <div class="float-card float-card-bottom">
          <span>eSIM</span>
          <b>Active</b>
        </div>
      </div>
    </section>

    <section class="device-strip" id="global" aria-label="Compatible devices">
      <span>Apple</span>
      <span>Samsung</span>
      <span>Pixel</span>
      <span>OPPO</span>
      <span>Vivo</span>
      <span>Nothing</span>
      <span>Xiaomi</span>
      <span>Honor</span>
      <span>Huawei</span>
    </section>

    <section class="section" id="steps">
      <div class="section-head">
        <p class="eyebrow">activation</p>
        <h2>Three simple steps</h2>
      </div>

      <div class="steps-grid">
        <article class="info-card">
          <span class="card-number">01</span>
          <h3>Choose a plan</h3>
          <p>Pick the data package you need and pay online with a convenient method.</p>
        </article>
        <article class="info-card">
          <span class="card-number">02</span>
          <h3>Get your QR code</h3>
          <p>Your activation code arrives by email right after purchase.</p>
        </article>
        <article class="info-card">
          <span class="card-number">03</span>
          <h3>Connect</h3>
          <p>Scan the QR code in your phone settings and stay online.</p>
        </article>
      </div>
    </section>

    <section class="section" id="plans">
      <div class="section-head">
        <p class="eyebrow">plans</p>
        <h2>Simple packages</h2>
      </div>

      <div class="plans-grid">
        @foreach (var product in Model.EsimProducts)
        {
          <article class="pass-card esim-card @(product.IsFeatured ? "is-featured" : "")">
            @if (product.IsFavorite)
            {
              <span class="favorite-badge">Favorite</span>
            }
            <div>
              <h2 data-product-i18n data-lang-en="@product.Name" data-lang-ru="@(string.IsNullOrWhiteSpace(product.NameRu) ? product.Name : product.NameRu)" data-lang-az="@(string.IsNullOrWhiteSpace(product.NameAz) ? product.Name : product.NameAz)">@product.Name</h2>
              @if (!string.IsNullOrWhiteSpace(product.Price) || !string.IsNullOrWhiteSpace(product.Period))
              {
                <p class="pass-price">@if (!string.IsNullOrWhiteSpace(product.Price)) { <span data-product-i18n data-lang-en="@product.Price" data-lang-ru="@(string.IsNullOrWhiteSpace(product.PriceRu) ? product.Price : product.PriceRu)" data-lang-az="@(string.IsNullOrWhiteSpace(product.PriceAz) ? product.Price : product.PriceAz)">@product.Price</span> } @if (!string.IsNullOrWhiteSpace(product.Price) && !string.IsNullOrWhiteSpace(product.Period)) { <span>| </span> } @if (!string.IsNullOrWhiteSpace(product.Period)) { <span data-product-i18n data-lang-en="@product.Period" data-lang-ru="@(string.IsNullOrWhiteSpace(product.PeriodRu) ? product.Period : product.PeriodRu)" data-lang-az="@(string.IsNullOrWhiteSpace(product.PeriodAz) ? product.Period : product.PeriodAz)">@product.Period</span> }</p>
              }
            </div>
            @if (product.Features.Count > 0)
            {
              <ul>
                @for (var featureIndex = 0; featureIndex < product.Features.Count; featureIndex++)
                {
                  var feature = product.Features[featureIndex];
                  var featureRu = product.FeaturesRu.Count > featureIndex ? product.FeaturesRu[featureIndex] : feature;
                  var featureAz = product.FeaturesAz.Count > featureIndex ? product.FeaturesAz[featureIndex] : feature;
                  <li data-product-i18n data-lang-en="@feature" data-lang-ru="@featureRu" data-lang-az="@featureAz">@feature</li>
                }
              </ul>
            }
            else if (!string.IsNullOrWhiteSpace(product.Description))
            {
              <ul>
                <li data-product-i18n data-lang-en="@product.Description" data-lang-ru="@(string.IsNullOrWhiteSpace(product.DescriptionRu) ? product.Description : product.DescriptionRu)" data-lang-az="@(string.IsNullOrWhiteSpace(product.DescriptionAz) ? product.Description : product.DescriptionAz)">@product.Description</li>
              </ul>
            }
            @if (!string.IsNullOrWhiteSpace(product.ButtonText))
            {
              <a class="plan-link" href="@(string.IsNullOrWhiteSpace(product.ButtonUrl) ? "#" : product.ButtonUrl)" data-product-i18n data-lang-en="@product.ButtonText" data-lang-ru="@(string.IsNullOrWhiteSpace(product.ButtonTextRu) ? product.ButtonText : product.ButtonTextRu)" data-lang-az="@(string.IsNullOrWhiteSpace(product.ButtonTextAz) ? product.ButtonText : product.ButtonTextAz)">@product.ButtonText</a>
            }
          </article>
        }
      </div>
    </section>

    <section class="support" id="wifi">
      <div>
        <p class="eyebrow">wi-fi fallback</p>
        <h2>Stay online between networks</h2>
        <p>Use El-Sim support to find nearby Wi-Fi and finish activation when mobile coverage is weak.</p>
      </div>
      <a class="button button-secondary" href="#support">Get help</a>
    </section>

    <section class="support" id="support">
      <div>
        <p class="eyebrow">support</p>
        <h2>We can help you connect</h2>
        <p>Message us if you need device checks, QR code help, or plan recommendations.</p>
      </div>
      <a class="button button-primary" href="#">Contact us</a>
    </section>
  </main>

