@{
    ViewData["Title"] = "Pass - El-Sim";
}

<main>
    <section class="pass-hero" aria-labelledby="pass-title">
      <p class="eyebrow">membership</p>
      <h1 id="pass-title">Pass</h1>
      <p>Unlock monthly El-Sim benefits, bonus data opportunities, partner rewards, and stronger network access.</p>
    </section>

    <section class="pass-grid" aria-label="Pass packages">
      <article class="pass-card is-featured">
        <span class="favorite-badge">Favorite</span>
        <div>
          <h2>Pass</h2>
          <p class="pass-price">4.00 AZN <span>| 30 days</span></p>
        </div>
        <ul>
          <li>Up to 50 free calls</li>
          <li>Bonuses from our partners</li>
          <li>Opportunity to earn up to 5GB</li>
          <li>Connection to next-generation 5G internet</li>
          <li>Up to 50% ad blocking</li>
        </ul>
        <a class="plan-link" href="#">Choose Pass</a>
      </article>

      <article class="pass-card">
        <div>
          <h2>Pass Plus</h2>
          <p class="pass-price">7.00 AZN <span>| 30 days</span></p>
        </div>
        <ul>
          <li>5G+ internet connection</li>
          <li>Up to 100 free calls</li>
          <li>Opportunity to earn up to 10GB</li>
          <li>Higher bonuses from partners</li>
          <li>Up to 70% ad blocking</li>
        </ul>
        <a class="plan-link" href="#">Choose Plus</a>
      </article>

      <article class="pass-card">
        <div>
          <h2>Pass Ultra</h2>
          <p class="pass-price">11.00 AZN <span>| 30 days</span></p>
        </div>
        <ul>
          <li>VIP customer service</li>
          <li>5G+ internet connection</li>
          <li>Up to 150 free calls</li>
          <li>Opportunity to earn up to 15GB</li>
          <li>Ultra bonuses from partners</li>
          <li>Ability to change the app icon</li>
          <li>Up to 90% ad blocking</li>
          <li>Network access anywhere in the Republic of Azerbaijan</li>
        </ul>
        <a class="plan-link" href="#">Choose Ultra</a>
      </article>
    </section>
  </main>

