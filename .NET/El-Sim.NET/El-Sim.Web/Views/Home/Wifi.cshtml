@{
    ViewData["Title"] = "WI-FI - El-Sim";
}

<main>
    <section class="pass-hero" aria-labelledby="wifi-title">
      <p class="eyebrow">fiber internet</p>
      <h1 id="wifi-title">Optical Internet</h1>
      <p>High-speed home and business connectivity with modern Wi-Fi standards and optional static IP.</p>
    </section>

    <section class="wifi-grid" aria-label="Optical internet packages">
      <article class="pass-card wifi-card">
        <div>
          <h2>Optic 1S</h2>
          <p class="pass-price">100.00 AZN</p>
        </div>
        <ul>
          <li>Up to 1 GBit/s</li>
          <li>Minimum Wi-Fi 6</li>
        </ul>
        <a class="plan-link" href="#">Choose 1S</a>
      </article>

      <article class="pass-card wifi-card">
        <div>
          <h2>Optic 1.5S</h2>
          <p class="pass-price">230.00 AZN</p>
        </div>
        <ul>
          <li>Up to 5 GBit/s</li>
          <li>Minimum Wi-Fi 6E</li>
        </ul>
        <a class="plan-link" href="#">Choose 1.5S</a>
      </article>

      <article class="pass-card wifi-card is-featured">
        <div>
          <h2>Optic 2S</h2>
          <p class="pass-price">450.00 AZN</p>
        </div>
        <ul>
          <li>Up to 10 GBit/s</li>
          <li>Minimum Wi-Fi 7</li>
        </ul>
        <a class="plan-link" href="#">Choose 2S</a>
      </article>

      <article class="pass-card wifi-card">
        <div>
          <h2>Optic 2S+</h2>
          <p class="pass-price">800.00 AZN</p>
        </div>
        <ul>
          <li>Up to 20 GBit/s</li>
          <li>Minimum Wi-Fi 7</li>
        </ul>
        <a class="plan-link" href="#">Choose 2S+</a>
      </article>
    </section>

    <section class="tariff-note wifi-note" aria-label="Static IP">
      <div>
        <h2>Static IP</h2>
        <p>Add a static IP to any optical internet package.</p>
      </div>
      <strong>+5%</strong>
    </section>
  </main>

