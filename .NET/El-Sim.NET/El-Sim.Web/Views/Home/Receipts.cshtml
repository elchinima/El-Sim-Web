@model List<UserReceiptViewModel>

@{
    ViewData["Title"] = "Receipts - El-Sim";
}

<main class="profile-shell">
  <section class="profile-panel" aria-label="Receipts">
    <div class="profile-head">
      <div>
        <p class="eyebrow">user profile</p>
        <h1>Receipts</h1>
      </div>
    </div>

    @if (Model.Count > 0)
    {
      <section class="profile-assets profile-history-list" aria-label="Receipts">
        @foreach (var receipt in Model)
        {
          <div class="profile-row">
            <span>@receipt.ReceiptNumber | @receipt.Type | @receipt.Status | @receipt.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yy HH:mm", CultureInfo.InvariantCulture)</span>
            <strong>@receipt.AmountAzn.ToString("F2", CultureInfo.InvariantCulture) AZN</strong>
          </div>
        }
      </section>
    }
    else
    {
      <div class="profile-row">
        <span>Receipts</span>
        <strong>No receipts yet</strong>
      </div>
    }

    <div class="profile-actions">
      <a class="button button-primary" href="/profile">Profile</a>
      <a class="button button-secondary" href="/profile/purchases">Purchases</a>
    </div>
  </section>
</main>
