@model ProductCategoryPageViewModel

@{
    ViewData["Title"] = "Plans - El-Sim";
}

<main>
    <section class="pass-hero" aria-labelledby="plans-title">
      <p class="eyebrow">@Model.Eyebrow</p>
      <h1 id="plans-title">@Model.Title</h1>
      <p>@Model.Description</p>
    </section>

    <section class="tariff-note" aria-label="eSIM prices and discount">
      <div>
        <h2>eSIM price</h2>
        <p>Exclusive 030 - 300 AZN</p>
      </div>
      <div>
        <p>033 - 100 AZN</p>
        <p>037 - 30 AZN</p>
        <p>035 - 15 AZN</p>
      </div>
      <strong>50% off all plans for the first month</strong>
    </section>

    <section class="tariff-grid" aria-label="Tariff packages">
      @foreach (var product in Model.Products)
      {
        <article class="pass-card tariff-card @(product.IsFeatured ? "is-featured" : "")">
          @if (product.IsFavorite)
          {
            <span class="favorite-badge">Favorite</span>
          }
          <div>
            <h2 data-product-i18n data-lang-en="@product.Name" data-lang-ru="@(string.IsNullOrWhiteSpace(product.NameRu) ? product.Name : product.NameRu)" data-lang-az="@(string.IsNullOrWhiteSpace(product.NameAz) ? product.Name : product.NameAz)">@product.Name</h2>
            <p class="pass-price"><span data-product-i18n data-lang-en="@product.Price" data-lang-ru="@(string.IsNullOrWhiteSpace(product.PriceRu) ? product.Price : product.PriceRu)" data-lang-az="@(string.IsNullOrWhiteSpace(product.PriceAz) ? product.Price : product.PriceAz)">@product.Price</span> @if (!string.IsNullOrWhiteSpace(product.Period)) { <span>| </span><span data-product-i18n data-lang-en="@product.Period" data-lang-ru="@(string.IsNullOrWhiteSpace(product.PeriodRu) ? product.Period : product.PeriodRu)" data-lang-az="@(string.IsNullOrWhiteSpace(product.PeriodAz) ? product.Period : product.PeriodAz)">@product.Period</span> }</p>
          </div>
          <ul>
            @for (var featureIndex = 0; featureIndex < product.Features.Count; featureIndex++)
            {
              var feature = product.Features[featureIndex];
              var featureRu = product.FeaturesRu.Count > featureIndex ? product.FeaturesRu[featureIndex] : feature;
              var featureAz = product.FeaturesAz.Count > featureIndex ? product.FeaturesAz[featureIndex] : feature;
              <li data-product-i18n data-lang-en="@feature" data-lang-ru="@featureRu" data-lang-az="@featureAz">@feature</li>
            }
          </ul>
          <a class="plan-link" href="#" data-product-i18n data-lang-en="@product.ButtonText" data-lang-ru="@(string.IsNullOrWhiteSpace(product.ButtonTextRu) ? product.ButtonText : product.ButtonTextRu)" data-lang-az="@(string.IsNullOrWhiteSpace(product.ButtonTextAz) ? product.ButtonText : product.ButtonTextAz)">@product.ButtonText</a>
        </article>
      }
    </section>

    <section class="tariff-details" aria-label="Pay as you go and speeds">
      <article class="pass-card tariff-info-card">
        <h2>No Plan</h2>
        <ul>
          <li>1 min - 0.20 AZN</li>
          <li>1 MB - 0.20 AZN, 4G+</li>
          <li>1 AZN - 7 days of all-network access</li>
        </ul>
      </article>

      <article class="pass-card tariff-info-card">
        <h2>Speeds</h2>
        <ul>
          <li>4G+ - up to 150 mbit/s (until 06.2026)</li>
          <li>4.5G - up to 250 mbit/s (until 01.2027)</li>
          <li>4.5G+ - up to 350 mbit/s</li>
          <li>5G - up to 850 mbit/s</li>
          <li>5G+ Beta from 06.2026 (only Ahmadli)</li>
          <li>5G+ - up to 1500 mbit/s</li>
        </ul>
      </article>
    </section>
  </main>

