@{
    ViewData["Title"] = "Plans - El-Sim";
}

<main>
    <section class="pass-hero" aria-labelledby="plans-title">
      <p class="eyebrow">tariffs</p>
      <h1 id="plans-title">Plans</h1>
      <p>Choose a monthly package with local minutes, local SMS, and mobile internet for everyday connection.</p>
    </section>

    <section class="tariff-note" aria-label="eSIM prices and discount">
      <div>
        <h2>eSIM price</h2>
        <p>Exclusive 030 - 300 AZN</p>
      </div>
      <div>
        <p>033 - 100 AZN</p>
        <p>037 - 30 AZN</p>
        <p>035 - 15 AZN</p>
      </div>
      <strong>50% off all plans for the first month</strong>
    </section>

    <section class="tariff-grid" aria-label="Tariff packages">
      <article class="pass-card tariff-card">
        <div>
          <h2>Eco</h2>
          <p class="pass-price">3.00 AZN <span>| 30 days</span></p>
        </div>
        <ul>
          <li>1GB internet</li>
          <li>30 free domestic minutes</li>
          <li>30 free domestic SMS</li>
        </ul>
        <a class="plan-link" href="#">Choose Eco</a>
      </article>

      <article class="pass-card tariff-card is-featured">
        <span class="favorite-badge">Favorite</span>
        <div>
          <h2>Standard</h2>
          <p class="pass-price">8.00 AZN <span>| 30 days</span></p>
        </div>
        <ul>
          <li>5GB internet</li>
          <li>50 free domestic minutes</li>
          <li>50 free domestic SMS</li>
        </ul>
        <a class="plan-link" href="#">Choose Standard</a>
      </article>

      <article class="pass-card tariff-card">
        <div>
          <h2>Plus</h2>
          <p class="pass-price">18.00 AZN <span>| 30 days</span></p>
        </div>
        <ul>
          <li>15GB internet</li>
          <li>150 free domestic minutes</li>
          <li>150 free domestic SMS</li>
        </ul>
        <a class="plan-link" href="#">Choose Plus</a>
      </article>

      <article class="pass-card tariff-card is-featured">
        <span class="favorite-badge">Favorite</span>
        <div>
          <h2>Pro</h2>
          <p class="pass-price">28.00 AZN <span>| 30 days</span></p>
        </div>
        <ul>
          <li>35GB internet</li>
          <li>350 free domestic minutes</li>
          <li>350 free domestic SMS</li>
        </ul>
        <a class="plan-link" href="#">Choose Pro</a>
      </article>

      <article class="pass-card tariff-card">
        <div>
          <h2>Premium</h2>
          <p class="pass-price">48.00 AZN <span>| 30 days</span></p>
        </div>
        <ul>
          <li>80GB internet</li>
          <li>800 free domestic minutes</li>
          <li>800 free domestic SMS</li>
        </ul>
        <a class="plan-link" href="#">Choose Premium</a>
      </article>

      <article class="pass-card tariff-card">
        <div>
          <h2>Ultra</h2>
          <p class="pass-price">78.00 AZN <span>| 30 days</span></p>
        </div>
        <ul>
          <li>120GB internet</li>
          <li>1200 free domestic minutes</li>
          <li>1200 free domestic SMS</li>
        </ul>
        <a class="plan-link" href="#">Choose Ultra</a>
      </article>
    </section>

    <section class="tariff-details" aria-label="Pay as you go and speeds">
      <article class="pass-card tariff-info-card">
        <h2>No Plan</h2>
        <ul>
          <li>1 min - 0.20 AZN</li>
          <li>1 MB - 0.20 AZN, 4G+</li>
          <li>1 AZN - 7 days of all-network access</li>
        </ul>
      </article>

      <article class="pass-card tariff-info-card">
        <h2>Speeds</h2>
        <ul>
          <li>4G+ - up to 150 mbit/s (until 06.2026)</li>
          <li>4.5G - up to 250 mbit/s (until 01.2027)</li>
          <li>4.5G+ - up to 350 mbit/s</li>
          <li>5G - up to 850 mbit/s</li>
          <li>5G+ Beta from 06.2026 (only Ahmadli)</li>
          <li>5G+ - up to 1500 mbit/s</li>
        </ul>
      </article>
    </section>
  </main>

